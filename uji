      { id: 'original', name: 'Original', filter: 'none' },
      { id: 'vintage', name: 'Vintage', filter: 'sepia(0.35) contrast(1.15) brightness(0.95) saturate(0.85)' },
      { id: 'bw', name: 'Black & White', filter: 'grayscale(1) contrast(1.2)' },
      { id: 'sepia', name: 'Sepia', filter: 'sepia(0.85) contrast(1.1)' },
      { id: 'warm', name: 'Warm', filter: 'sepia(0.2) saturate(1.3) hue-rotate(-10deg)' },
      { id: 'cool', name: 'Cool', filter: 'saturate(0.9) hue-rotate(15deg) contrast(1.05)' },
      { id: 'contrast', name: 'High Contrast', filter: 'contrast(1.4) brightness(0.95)' },
      { id: 'soft', name: 'Soft Film', filter: 'brightness(1.05) contrast(0.9) saturate(0.85)' }
    ];

    // Filter Apply State
    let applyMode = 'all'; // 'all' or 'individual'
    let photoFilters = ['vintage', 'vintage', 'vintage', 'vintage']; // Default vintage filter per photo slot
    let selectedPhotoIndex = 0;

    // Payment state
    let isPaymentConfirmed = false;

    // DOM Elements Cache
    const video = document.getElementById('video');
    const posterCanvas = document.getElementById('poster-canvas');
    const ctx = posterCanvas.getContext('2d');

    // Lifecycle Initialization
    window.onload = function() {
      initFilterButtons();
      renderStepView();
    };

    // Step Routing Handler (Single Page App State Controller)
    function goToStep(step) {
      currentStep = step;
      renderStepView();

      if (step === 2) {
        initCamera();
      } else {
        stopCamera();
      }

      if (step === 3) {
        renderWantedPosterCanvas();
      }
    }

    function renderStepView() {
      // Toggle Screens
      document.getElementById('screen-welcome').classList.toggle('hidden', currentStep !== 1);
      document.getElementById('screen-camera').classList.toggle('hidden', currentStep !== 2);
      document.getElementById('screen-filter').classList.toggle('hidden', currentStep !== 3);
      document.getElementById('screen-payment').classList.toggle('hidden', currentStep !== 4);

      // Update Header Badges
      for (let i = 1; i <= 4; i++) {
        const badge = document.getElementById(`step-${i}-badge`);
        if (badge) {
          if (i === currentStep) {
            badge.className = 'px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 font-bold border border-amber-500/40';
          } else {
            badge.className = 'px-2 py-0.5 rounded text-zinc-500';
          }
        }
      }
    }

    /* ================= E. CAMERA CAPTURE LOGIC ================= */
    async function initCamera() {
      const errorEl = document.getElementById('camera-error');
      errorEl.classList.add('hidden');

      try {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          throw new Error('Browser Anda tidak mendukung kamera API.');
        }

        // List cameras
        const devices = await navigator.mediaDevices.enumerateDevices();
        availableCameras = devices.filter(d => d.kind === 'videoinput');

        const constraints = {
          video: availableCameras.length > 0 ? {
            deviceId: availableCameras[currentCameraIndex] ? { exact: availableCameras[currentCameraIndex].deviceId } : undefined,
            width: { ideal: 1280 },
            height: { ideal: 960 },
            facingMode: 'user'
          } : true,
          audio: false
        };

        if (mediaStream) {
          stopCamera();
        }

        mediaStream = await navigator.mediaDevices.getUserMedia(constraints);
        video.srcObject = mediaStream;
      } catch (err) {
        console.error('Camera Error:', err);
        document.getElementById('camera-error-msg').innerText = err.message || 'Izin kamera ditolak atau kamera tidak ditemukan.';
        errorEl.classList.remove('hidden');
      }
    }

    function stopCamera() {
      if (mediaStream) {
        mediaStream.getTracks().forEach(track => track.stop());
        mediaStream = null;
      }
    }

    function switchCamera() {
      if (availableCameras.length > 1) {
        currentCameraIndex = (currentCameraIndex + 1) % availableCameras.length;
        initCamera();
      } else {
        alert('Hanya 1 periferal kamera yang terdeteksi.');
      }
    }

    async function startPhotoSequence() {
      const btnCapture = document.getElementById('btn-capture');
      btnCapture.disabled = true;
      btnCapture.classList.add('opacity-50');

      capturedPhotos = [null, null, null, null];
      updatePhotoGridUI();

      for (let i = 0; i < 4; i++) {
        await runCountdown(3);
        flashShutter();
        const photoData = captureSingleFrame();
        capturedPhotos[i] = photoData;
        updatePhotoGridUI();
        await new Promise(resolve => setTimeout(resolve, 600));
      }

      btnCapture.disabled = false;
      btnCapture.classList.remove('opacity-50');
      document.getElementById('btn-retake').classList.remove('hidden');
    }

    function runCountdown(seconds) {
      return new Promise((resolve) => {
        const overlay = document.getElementById('countdown-overlay');
        const text = document.getElementById('countdown-text');
        overlay.classList.remove('hidden');
        
        let count = seconds;
        text.innerText = count;

        const interval = setInterval(() => {
          count--;
          if (count > 0) {
            text.innerText = count;
          } else {
            clearInterval(interval);
            overlay.classList.add('hidden');
            resolve();
          }
        }, 800);
      });
    }

    function flashShutter() {
      const flash = document.getElementById('shutter-flash');
      flash.classList.remove('opacity-0');
      flash.classList.add('opacity-100');
      setTimeout(() => {
        flash.classList.remove('opacity-100');
        flash.classList.add('opacity-0');
      }, 150);
    }

    function captureSingleFrame() {
      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = video.videoWidth || 1280;
      tempCanvas.height = video.videoHeight || 960;
      const tCtx = tempCanvas.getContext('2d');

      // Mirror video frame horizontally for natural look
      tCtx.translate(tempCanvas.width, 0);
      tCtx.scale(-1, 1);
      tCtx.drawImage(video, 0, 0, tempCanvas.width, tempCanvas.height);

      return tempCanvas.toDataURL('image/png');
    }

    function handleFileUpload(event) {
      const files = Array.from(event.target.files).slice(0, 4);
      if (files.length === 0) return;

      let loadedCount = 0;
      files.forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          capturedPhotos[index] = e.target.result;
          loadedCount++;
          if (loadedCount === files.length) {
            updatePhotoGridUI();
            document.getElementById('btn-retake').classList.remove('hidden');
          }
        };
        reader.readAsDataURL(file);
      });
    }

    function resetPhotos() {
      capturedPhotos = [null, null, null, null];
      updatePhotoGridUI();
      document.getElementById('btn-retake').classList.add('hidden');
    }

    function updatePhotoGridUI() {
      let filledCount = 0;
      for (let i = 0; i < 4; i++) {
        const slot = document.getElementById(`slot-${i}`);
        if (capturedPhotos[i]) {
          filledCount++;
          slot.innerHTML = `<img src="${capturedPhotos[i]}" class="w-full h-full object-cover rounded-lg">`;
          slot.classList.remove('border-dashed');
          slot.classList.add('border-solid', 'border-amber-500');
        } else {
          slot.innerHTML = `<span class="text-xs text-zinc-600 font-bold">#${i + 1}</span>`;
          slot.classList.add('border-dashed');
          slot.classList.remove('border-solid', 'border-amber-500');
        }
      }

      document.getElementById('photo-count').innerText = filledCount;
      const btnNext = document.getElementById('btn-next-filter');
      
      if (filledCount === 4) {
        btnNext.disabled = false;
        btnNext.className = "w-full py-3 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-black rounded-xl transition shadow-lg cursor-pointer text-sm flex items-center justify-center space-x-2";
      } else {
        btnNext.disabled = true;
        btnNext.className = "w-full py-3 bg-zinc-800 text-zinc-500 font-bold rounded-xl transition cursor-not-allowed text-sm flex items-center justify-center space-x-2";
      }
    }


    /* ================= F. FILTER SELECTION LOGIC ================= */
    function initFilterButtons() {
      const container = document.getElementById('filter-buttons-container');
      container.innerHTML = '';

      FILTERS.forEach(f => {
        const btn = document.createElement('button');
        btn.id = `btn-filter-${f.id}`;
        btn.onclick = () => applyFilterSelection(f.id);
        btn.className = 'px-3 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-semibold rounded-lg border border-zinc-700 transition text-left flex items-center justify-between';
        btn.innerHTML = `<span>${f.name}</span><i class="fa-solid fa-wand-magic-sparkles text-[10px] text-amber-500/0"></i>`;
        container.appendChild(btn);
      });
      highlightActiveFilterBtn();
    }

    function setFilterApplyMode(mode) {
      applyMode = mode;
      document.getElementById('mode-all').className = mode === 'all' 
        ? 'flex-1 py-1.5 rounded-md text-center bg-amber-600 text-zinc-950 font-bold'
        : 'flex-1 py-1.5 rounded-md text-center text-zinc-400 hover:text-zinc-200';
      document.getElementById('mode-individual').className = mode === 'individual'
        ? 'flex-1 py-1.5 rounded-md text-center bg-amber-600 text-zinc-950 font-bold'
        : 'flex-1 py-1.5 rounded-md text-center text-zinc-400 hover:text-zinc-200';

      document.getElementById('individual-photo-selectors').classList.toggle('hidden', mode !== 'individual');
      highlightActiveFilterBtn();
    }

    function setSelectedPhotoIndex(idx) {
      selectedPhotoIndex = idx;
      const btns = document.querySelectorAll('.photo-idx-btn');
      btns.forEach((btn, i) => {
        if (i === idx) {
          btn.className = 'photo-idx-btn px-2 py-1 text-xs rounded bg-amber-600 text-zinc-950 font-bold border border-amber-500';
        } else {
          btn.className = 'photo-idx-btn px-2 py-1 text-xs rounded bg-zinc-800 text-zinc-400 border border-zinc-700';
        }
      });
      highlightActiveFilterBtn();
    }

    function applyFilterSelection(filterId) {
      if (applyMode === 'all') {
        photoFilters = [filterId, filterId, filterId, filterId];
      } else {
        photoFilters[selectedPhotoIndex] = filterId;
      }
      highlightActiveFilterBtn();
      renderWantedPosterCanvas();
    }

    function highlightActiveFilterBtn() {
      const activeFilterId = applyMode === 'all' ? photoFilters[0] : photoFilters[selectedPhotoIndex];
      FILTERS.forEach(f => {
        const btn = document.getElementById(`btn-filter-${f.id}`);
        if (btn) {
          if (f.id === activeFilterId) {
            btn.className = 'px-3 py-2 bg-amber-600 text-zinc-950 text-xs font-bold rounded-lg border border-amber-400 transition text-left flex items-center justify-between shadow';
          } else {
            btn.className = 'px-3 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-semibold rounded-lg border border-zinc-700 transition text-left flex items-center justify-between';
          }
        }
      });
    }


    /* ================= D & G. CANVA WANTED POSTER GENERATOR ================= */
    async function renderWantedPosterCanvas() {
      const canvas = posterCanvas;
      const W = canvas.width;  // 1240 px (scaled down for preview, exports at high res)
      const H = canvas.height; // 1754 px A4 ratio

      // Clear Canvas
      ctx.clearRect(0, 0, W, H);

      // 1. Background Paper Texture Effect
      ctx.fillStyle = '#f4ebd0';
      ctx.fillRect(0, 0, W, H);

      // Paper grain noise
      ctx.fillStyle = 'rgba(58, 50, 42, 0.03)';
      for (let i = 0; i < W; i += 8) {
        for (let j = 0; j < H; j += 8) {
          if (Math.random() > 0.5) {
            ctx.fillRect(i, j, 4, 4);
          }
        }
      }

      // Outer Vintage Border Lines
      ctx.strokeStyle = '#211c18';
      ctx.lineWidth = 8;
      ctx.strokeRect(30, 30, W - 60, H - 60);

      ctx.lineWidth = 3;
      ctx.strokeRect(42, 42, W - 84, H - 84);

      // 2. BREAKING NEWS Boxes Left & Right
      ctx.fillStyle = '#211c18';
      ctx.fillRect(55, 55, 230, 50);
      ctx.fillRect(W - 285, 55, 230, 50);

      ctx.fillStyle = '#f4ebd0';
      ctx.font = 'bold 22px "Rye", serif';
      ctx.textAlign = 'center';
      ctx.fillText('BREAKING', 170, 77);
      ctx.fillText('NEWS', 170, 97);

      ctx.fillText('BREAKING', W - 170, 77);
      ctx.fillText('NEWS', W - 170, 97);

      // 3. Center Header Title ✦ PPG CLASSIFIED ✦
      ctx.fillStyle = '#211c18';
      ctx.font = 'bold 36px "Rye", serif';
      ctx.textAlign = 'center';
      ctx.fillText('✦ PPG CLASSIFIED ✦', W / 2, 92);

      // 4. Dark Info Bar: VOL. 02, NO. 2026, GELAR KARYA, KELOMPOK B PPKn
      ctx.fillStyle = '#211c18';
      ctx.fillRect(55, 120, W - 110, 45);

      ctx.fillStyle = '#f4ebd0';
      ctx.font = 'bold 18px "Special Elite", monospace';
      ctx.textAlign = 'center';
      ctx.fillText('VOL. 02  |  NO. 2026  |  GELAR KARYA  |  KELOMPOK B PPKn', W / 2, 148);

      // 5. Giant Header "WANTED"
      ctx.fillStyle = '#211c18';
      ctx.font = '900 135px "Rye", serif';
      ctx.textAlign = 'center';
      ctx.fillText('WANTED', W / 2, 280);

      // 6. Two Horizontal Divider Lines
      ctx.lineWidth = 6;
      ctx.beginPath();
      ctx.moveTo(55, 300);
      ctx.lineTo(W - 55, 300);
      ctx.stroke();

      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(55, 308);
      ctx.lineTo(W - 55, 308);
      ctx.stroke();

      // 7. Area 4 Foto Grid 2x2
      const gridX = 75;
      const gridY = 330;
      const gridW = W - 150; // 1090
      const gridH = 1080;
      
      const photoW = (gridW - 30) / 2; // 530
      const photoH = (gridH - 30) / 2; // 525

      const photoCoords = [
        { x: gridX, y: gridY },
        { x: gridX + photoW + 30, y: gridY },
        { x: gridX, y: gridY + photoH + 30 },
        { x: gridX + photoW + 30, y: gridY + photoH + 30 }
      ];

      // Draw Photos onto Canvas asynchronously
      for (let i = 0; i < 4; i++) {
        const coord = photoCoords[i];
        
        // Photo Inner Border Box
        ctx.strokeStyle = '#211c18';
        ctx.lineWidth = 4;
        ctx.strokeRect(coord.x, coord.y, photoW, photoH);

        if (capturedPhotos[i]) {
          await drawFilteredPhoto(ctx, capturedPhotos[i], photoFilters[i], coord.x + 6, coord.y + 6, photoW - 12, photoH - 12);
        } else {
          ctx.fillStyle = '#ebdcb9';
          ctx.fillRect(coord.x + 6, coord.y + 6, photoW - 12, photoH - 12);
          ctx.fillStyle = '#a39274';
          ctx.font = 'bold 28px "Special Elite", monospace';
          ctx.textAlign = 'center';
          ctx.fillText(`FOTO #${i + 1}`, coord.x + photoW / 2, coord.y + photoH / 2);
        }
      }

      // 8. Footer Area
      const footerY = 1440;
      ctx.lineWidth = 4;
      ctx.strokeRect(55, footerY, W - 110, 240);

      // Border frame inner
      ctx.lineWidth = 1.5;
      ctx.strokeRect(63, footerY + 8, W - 126, 224);

      // THANK YOU & FOR COMING Text
      ctx.fillStyle = '#211c18';
      ctx.font = '900 68px "Playfair Display", serif';
      ctx.textAlign = 'center';
      ctx.fillText('THANK YOU', W / 2, footerY + 85);

      ctx.font = 'bold 52px "Playfair Display", serif';
      ctx.fillText('FOR COMING', W / 2, footerY + 155);

      // 9. Stars & Decorative Ornament
      ctx.font = '28px sans-serif';
      ctx.fillText('★  ★  ★', W / 2, footerY + 205);

      // 10. Date Format DD/MM/YY in Bottom Right Corner
      const today = new Date();
      const dd = String(today.getDate()).padStart(2, '0');
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const yy = String(today.getFullYear()).slice(-2);
      const dateStr = `${dd}/${mm}/${yy}`;

      ctx.font = 'bold 22px "Special Elite", monospace';
      ctx.textAlign = 'right';
      ctx.fillText(`DATE: ${dateStr}`, W - 75, H - 45);

      ctx.textAlign = 'left';
      ctx.fillText(`PPG GELAR KARYA 2026`, 75, H - 45);
    }

    // Helper function to draw image with dynamic canvas context filters
    function drawFilteredPhoto(context, imgSrc, filterId, x, y, w, h) {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => {
          context.save();
          
          // Find filter config
          const fObj = FILTERS.find(f => f.id === filterId) || FILTERS[0];
          context.filter = fObj.filter;

          // Draw cropped & fitted image (object-fit cover equivalent)
          const imgAspect = img.width / img.height;
          const rectAspect = w / h;
          let sx, sy, sw, sh;

          if (imgAspect > rectAspect) {
            sh = img.height;
            sw = img.height * rectAspect;
            sx = (img.width - sw) / 2;
            sy = 0;
          } else {
            sw = img.width;
            sh = img.width / rectAspect;
            sx = 0;
            sy = (img.height - sh) / 2;
          }

          context.drawImage(img, sx, sy, sw, sh, x, y, w, h);
          context.restore();
          resolve();
        };
        img.src = imgSrc;
      });
    }


    /* ================= H. CASH PAYMENT & DOWNLOAD LOGIC ================= */
    function openPaymentModal() {
      if (isPaymentConfirmed) return;
      document.getElementById('modal-payment').classList.remove('hidden');
    }

    function closePaymentModal() {
      document.getElementById('modal-payment').classList.add('hidden');
    }

    function processPaymentConfirmation() {
      isPaymentConfirmed = true;
      closePaymentModal();

      // Update UI Status Box
      const statusBox = document.getElementById('payment-status-box');
      statusBox.className = 'mb-6 p-4 rounded-xl border bg-emerald-950/30 border-emerald-800/60 text-emerald-300 flex items-start space-x-3';
      statusBox.innerHTML = `
        <i class="fa-solid fa-circle-check text-xl text-emerald-400 mt-0.5"></i>
        <div class="text-xs space-y-1">
          <p class="font-bold text-emerald-300 text-sm">Terima kasih! Pembayaran tunai telah dikonfirmasi.</p>
          <p class="text-emerald-200/80">Silahkan klik tombol di bawah untuk mengunduh Wanted Poster hasil sesi Anda.</p>
        </div>
      `;

      // Enable Download Button & Disable Confirm Button
      const btnConfirm = document.getElementById('btn-confirm-pay');
      btnConfirm.disabled = true;
      btnConfirm.className = 'w-full py-3 bg-zinc-800 text-zinc-500 font-bold text-sm rounded-xl border border-zinc-700 cursor-not-allowed hidden';

      const btnDownload = document.getElementById('btn-download-poster');
      btnDownload.disabled = false;
      btnDownload.className = 'w-full py-4 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-black text-base rounded-xl shadow-lg transition flex items-center justify-center space-x-2 cursor-pointer animate-bounce';
    }

    function downloadPoster() {
      if (!isPaymentConfirmed) {
        alert('Silahkan konfirmasi pembayaran tunai terlebih dahulu.');
        return;
      }

      // Generate High-Res Canvas download
      const link = document.createElement('a');
      link.download = 'PPG-Photobooth-Kelompok-B-PPKn-2026.png';
      link.href = posterCanvas.toDataURL('image/png', 1.0);
      link.click();
    }
  </script>
